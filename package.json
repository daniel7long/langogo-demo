{
  "name": "langogo-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive full-screen demo deck for the Langogo app (React).",
  "scripts": {
    "build": "esbuild src/app.jsx --bundle --minify --format=iife --target=es2019 --jsx=transform --define:process.env.NODE_ENV=\\\"production\\\" --outfile=site/app.js",
    "start": "npm run build && serve site"
  },
  "dependencies": { "react": "^19.2.0", "react-dom": "^19.2.0" },
  "devDependencies": { "esbuild": "^0.25.0", "serve": "^14.2.0" }
}
